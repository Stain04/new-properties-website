# Normalise line endings: LF in the repository, native in the working copy.
# Keeps diffs clean when the project is cloned on macOS or Linux.
* text=auto eol=lf

# Binary assets — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
