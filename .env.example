# ─────────────────────────────────────────────────────────────
#  Copy this file to .env.local (on your computer) or paste the
#  values into your host's "Environment variables" settings.
#  Never commit the real values.
# ─────────────────────────────────────────────────────────────

# ── Site address ─────────────────────────────────────────
# Used in link previews (WhatsApp, Facebook…), the sitemap and Google data.
# On Vercel this is detected automatically — only set it on other hosts,
# or to force a specific domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# ── Admin panel (/admin) ─────────────────────────────────────
# The password the agency uses to log in. Make it long.
ADMIN_PASSWORD=

# Random text, at least 32 characters, used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ── Cloud storage (optional locally, required on Vercel) ─────
# Without these, listings and photos are saved in the data/ folder.
# With them, they're saved to Supabase Storage. Setup: README → Managing listings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name. Leave as "site" unless you have a reason to change it.
SUPABASE_BUCKET=site
